{
  "name": "codex-spec-workflow",
  "version": "0.1.1",
  "description": "Codex-native, approval-gated specification and bug-fix workflows",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "codex-spec": "./dist/cli.js",
    "codex-spec-dashboard": "./dist/dashboard/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "src-tauri",
    ".codex-plugin",
    ".agents/plugins/marketplace.json",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-permissions.mjs",
    "clean": "rimraf dist coverage",
    "dev": "tsx src/cli.ts",
    "dashboard": "tsx src/dashboard/cli.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "codex",
    "spec-workflow",
    "requirements",
    "design",
    "task-execution",
    "bug-fix"
  ],
  "author": "Codex Spec Workflow contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbaghilovici/codex-spec-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/danbaghilovici/codex-spec-workflow/issues"
  },
  "homepage": "https://github.com/danbaghilovici/codex-spec-workflow#readme",
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "fastify": "^5.6.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tauri-apps/cli": "^2.8.5",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
